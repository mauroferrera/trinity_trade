# ===================================
# MultiMarket Quant Engine - .env.example
# ===================================

# Entorno de ejecución
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Servidor FastAPI
HOST=0.0.0.0
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# Base de datos
DATABASE_URL=sqlite:///trading.db
# Para PostgreSQL (futuro): postgresql+psycopg2://user:pass@localhost:5432/dbname

# ===================================
# PROVEEDORES DE DATOS - BRASIL (B3)
# ===================================

# Nelogica / Profit Open API
NELOGICA_API_KEY=
NELOGICA_API_SECRET=
NELOGICA_ENVIRONMENT=production  # production | sandbox

# Cedro Technologies (FastTrade/Anywhere API)
CEDRO_API_KEY=
CEDRO_API_SECRET=
CEDRO_WS_URL=wss://api.cedrotech.com/streaming
CEDRO_REST_URL=https://api.cedrotech.com

# MetaTrader 5 (B3 / Forex)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# ===================================
# PROVEEDORES DE DATOS - CRIPTO
# ===================================

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# Bybit (CCXT)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# ===================================
# DATOS MACRO / EXTERNOS
# ===================================

# Banco Central do Brasil (BCB) - API pública, sin clave requerida
BCB_API_BASE_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs

# Fear & Greed Index (Alternative.me) - API pública
FEAR_GREED_API_URL=https://api.alternative.me/fng/

# ===================================
# AGENTE IA / LLM (LiteLLM)
# ===================================

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# LiteLLM - Configuración Router/Fallback
LITELLM_MODEL=gpt-4o-mini
LITELLM_FALLBACK_ORDER=gemini-2.5-flash,claude-3-5-haiku-latest

# ===================================
# DATABENTO (CME/Order Flow)
# ===================================

DATABENTO_API_KEY=

# ===================================
# CONFIGURACIÓN DE RIESGO / ESTRATEGIA
# ===================================

# Path override opcional para strategy.yaml
# STRATEGY_PATH=/path/to/strategy.yaml

# ===================================
# OTROS
# ===================================

TZ=UTC
